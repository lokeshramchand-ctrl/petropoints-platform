# Copy to .env.development (local) or provide via secret manager (production). Never commit real values.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

DATABASE_URL=postgres://petropoints:petropoints_dev@localhost:5432/petropoints
DATABASE_REPLICA_URL=
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092

# >= 32 chars. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-access-secret-change-me-dev-access-secret
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-dev-refresh-secret
SLIP_HMAC_SECRET=dev-slip-secret-change-me-dev-slip-secret-xx
PII_HASH_PEPPER=dev-pepper-change-me-dev-pepper-change-me

# Fake email (Mailpit UI: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="PetroPoints <no-reply@petropoints.local>"

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SWAGGER_ENABLED=true

# Analytics workers
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=petropoints
CLICKHOUSE_PASSWORD=petropoints_dev
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_ACCESS_KEY=petropoints
S3_SECRET_KEY=petropoints_dev
S3_BUCKET=petropoints-lake

# First super admin (used once by `pnpm --filter @petropoints/api seed:admin`)
SEED_ADMIN_EMAIL=admin@petropoints.local
SEED_ADMIN_PASSWORD=
