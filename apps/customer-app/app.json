{
  "expo": {
    "name": "PetroPoints",
    "slug": "petropoints-customer",
    "scheme": "petropoints",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "in.petropoints.customer",
      "allowBackup": false
    },
    "ios": {
      "bundleIdentifier": "in.petropoints.customer",
      "supportsTablet": false
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-status-bar"],
    "experiments": { "typedRoutes": true }
  }
}
